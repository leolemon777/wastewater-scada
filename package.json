{
  "name": "wastewater-scada",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:scene": "node scripts/check-scene.mjs",
    "verify:scene": "npm run check:scene && npm run build",
    "hub:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/scada-hub.ps1 restore",
    "hub:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/scada-hub.ps1 build",
    "hub:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/scada-hub.ps1 test",
    "hub:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-scada-hub-runtime.ps1",
    "hub:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/scada-hub.ps1 run",
    "verify:all": "npm run verify:scene && npm run lint && npm run hub:test && npm run hub:runtime",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:secrets": "node scripts/checks/security/check-secrets.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@types/three": "^0.183.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
